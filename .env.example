# Neon PostgreSQL Database URL (pooled connection)
DATABASE_URL="postgresql://user:password@endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# UploadThing Storage Credentials
UPLOADTHING_TOKEN="your_uploadthing_token_here"
UPLOADTHING_SECRET="your_uploadthing_secret_here"
UPLOADTHING_APP_ID="your_uploadthing_app_id_here"

# Admin JWT Authentication Secret
ADMIN_JWT_SECRET="your_admin_jwt_secret_key_here"
